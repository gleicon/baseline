[agent]
node_id               = "{{ inventory_hostname }}"
manifest_path         = "{{ baseline_manifest_path }}"
heartbeat_interval_sec = {{ baseline_heartbeat_interval_sec }}
audit_interval_sec    = {{ baseline_audit_interval_sec }}
audit_jitter_max_sec  = {{ baseline_audit_jitter_max_sec }}
{% if baseline_otlp_endpoint is defined and baseline_otlp_endpoint %}
otlp_endpoint         = "{{ baseline_otlp_endpoint }}"
{% endif %}
# !!! WARNING !!!
# Auto-remediation enforces ONLY the packages & services recorded in the
# manifest snapshot. It does NOT restore users, cron, firewall, sysctl, or any
# other state that Ansible/IaC manages — re-running the provisioning playbook
# is the only complete fix. OFF by default (detect + IaS fix).
# remediate             = {{ 'true' if baseline_remediate | default(false) else 'false' }}
