[agent]
node_id               = "{{ inventory_hostname }}"
manifest_path         = "{{ baseline_manifest_path }}"
heartbeat_interval_sec = {{ baseline_heartbeat_interval_sec }}
audit_interval_sec    = {{ baseline_audit_interval_sec }}
audit_jitter_max_sec  = {{ baseline_audit_jitter_max_sec }}
{% if baseline_otlp_endpoint is defined and baseline_otlp_endpoint %}
otlp_endpoint         = "{{ baseline_otlp_endpoint }}"
{% endif %}
# Baseline detects and reports; it never changes this node. Drift is fixed by
# re-running the provisioning playbook (IaS owns the desired state).
