# E2E stage 1: build the agent from this repo.
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /baseline-agent ./cmd/agent

# E2E stage 2: minimal Debian target with a provisioned baseline.
FROM debian:bookworm-slim
RUN apt-get update -q \
  && apt-get install -y -q --no-install-recommends ca-certificates dpkg \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /baseline-agent /usr/local/bin/baseline-agent
COPY e2e/agent.toml /etc/baseline/agent.toml
COPY e2e/baseline/sentinel.txt /etc/baseline/sentinel
RUN mkdir -p /etc/baseline \
  && printf 'Authorized access only.\n' > /etc/motd \
  && /usr/local/bin/baseline-agent -write-manifest \
    -manifest /etc/baseline/manifest.json \
    -files /etc/baseline/sentinel,/etc/motd \
    -packages bash -snapshot
CMD ["/usr/local/bin/baseline-agent", "-config", "/etc/baseline/agent.toml"]